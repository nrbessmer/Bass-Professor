<?xml version="1.0" encoding="UTF-8"?>

<JUCERPROJECT id="BPxSyn" name="Bass Professor" projectType="audioplug" useAppConfig="0"
              addUsingNamespaceToJuceHeader="0" jucerFormatVersion="1" companyName="Tully EDM Vibe"
              companyCopyright="(c)(p) 2026 Tully EDM Vibe" companyWebsite="www.tullyedmvibe.com"
              companyEmail="info@tullyedmvibe.com" pluginName="Bass Professor"
              pluginDesc="3-band bass synthesizer - dual/wavetable/FM engines, per-band filters and drive, AM injector"
              pluginManufacturer="Tully EDM Vibe" pluginManufacturerCode="Tull"
              pluginCode="Bpro" pluginFormats="buildAU,buildStandalone,buildVST3"
              pluginCharacteristicsValue="pluginIsSynth,pluginWantsMidiIn"
              pluginAUMainType="'aumu'" pluginAUExportPrefix="BassProfessorAU"
              pluginVST3Category="Instrument,Synth"
              bundleIdentifier="com.TullyEDMVibe.BassProfessor" cppLanguageStandard="17">
  <MAINGROUP id="BPMain" name="Bass Professor">
    <GROUP id="{BP000001-0000-0000-0000-000000000001}" name="Source">
      <FILE id="bpProcCpp" name="PluginProcessor.cpp" compile="1" resource="0"
            file="Source/PluginProcessor.cpp"/>
      <FILE id="bpProcH" name="PluginProcessor.h" compile="0" resource="0"
            file="Source/PluginProcessor.h"/>
      <FILE id="bpEditCpp" name="PluginEditor.cpp" compile="1" resource="0"
            file="Source/PluginEditor.cpp"/>
      <FILE id="bpEditH" name="PluginEditor.h" compile="0" resource="0" file="Source/PluginEditor.h"/>
      <FILE id="bpVoiceCpp" name="SynthVoice.cpp" compile="1" resource="0" file="Source/SynthVoice.cpp"/>
      <FILE id="bpVoiceH" name="SynthVoice.h" compile="0" resource="0" file="Source/SynthVoice.h"/>
      <FILE id="bpSoundH" name="SynthSound.h" compile="0" resource="0" file="Source/SynthSound.h"/>
      <FILE id="bpParamsH" name="Params.h" compile="0" resource="0" file="Source/Params.h"/>
      <FILE id="bpLnfH" name="BassProfessorLookAndFeel.h" compile="0" resource="0"
            file="Source/BassProfessorLookAndFeel.h"/>
      <GROUP id="{BP000001-0000-0000-0000-000000000002}" name="DSP">
        <FILE id="bpUtils" name="Utils.h" compile="0" resource="0" file="Source/DSP/Utils.h"/>
        <FILE id="bpDualOsc" name="DualOscillator.h" compile="0" resource="0" file="Source/DSP/DualOscillator.h"/>
        <FILE id="bpWtOsc" name="WavetableOscillator.h" compile="0" resource="0" file="Source/DSP/WavetableOscillator.h"/>
        <FILE id="bpFmOsc" name="FmOscillator.h" compile="0" resource="0" file="Source/DSP/FmOscillator.h"/>
        <FILE id="bpFilter" name="MultiModeFilter.h" compile="0" resource="0" file="Source/DSP/MultiModeFilter.h"/>
        <FILE id="bpLR" name="LinkwitzRiley.h" compile="0" resource="0" file="Source/DSP/LinkwitzRiley.h"/>
        <FILE id="bpBand" name="SynthBand.h" compile="0" resource="0" file="Source/DSP/SynthBand.h"/>
        <FILE id="bpLfo" name="ModLFO.h" compile="0" resource="0" file="Source/DSP/ModLFO.h"/>
        <FILE id="bpDelay" name="StereoDelay.h" compile="0" resource="0" file="Source/DSP/StereoDelay.h"/>
      </GROUP>
    </GROUP>
  </MAINGROUP>
  <MODULES>
    <MODULE id="juce_audio_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_devices" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
    <MODULE id="juce_audio_formats" showAllCode="1" useLocalCopy="0" useGlobalPath="1"/>
